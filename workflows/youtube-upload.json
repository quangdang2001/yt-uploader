    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Doc file .json metadata, kiem tra va chuan hoa truoc khi upload.\nconst cfg = $('Cau hinh kenh').first().json;\nconst trigger = $('Trigger Drive pending').first().json;\n\nlet meta;\ntry {\n  meta = JSON.parse($input.first().json.metaRaw);\n} catch (e) {\n  throw new Error(`File ${trigger.name} khong phai JSON hop le: ${e.message}`);\n}\n\nconst baseName = String(trigger.name).replace(/\\.json$/i, '');\nif (!baseName) {\n  throw new Error(`Ten file khong hop le: ${trigger.name}`);\n}\n\nif (!meta.title || !String(meta.title).trim()) {\n  throw new Error(`Thieu truong \"title\" trong ${trigger.name}`);\n}\n\n// YouTube: title toi da 100 ky tu, description 5000\nconst title = String(meta.title).trim().slice(0, 100);\nconst description = String(meta.description || '').slice(0, 5000);\n\n// tags co the la array hoac string phan cach bang dau phay; tong do dai <= 500\nlet tags = meta.tags || [];\nif (typeof tags === 'string') tags = tags.split(',');\ntags = tags.map((t) => String(t).trim()).filter(Boolean);\nwhile (tags.length && tags.join(',').length > 480) tags.pop();\n\nlet privacyStatus = ['private', 'unlisted', 'public'].includes(meta.privacyStatus)\n  ? meta.privacyStatus\n  : 'private';\n\n// publishAt chi hoat dong khi video dang o trang thai private\nif (meta.publishAt) privacyStatus = 'private';\n\n// videos.update voi part=status GHI DE toan bo object status: field nao khong\n// gui se bi reset ve mac dinh. Nen build san mot object status day du o day va\n// dung lai y nguyen o buoc \"Cap nhat status video\".\nconst status = {\n  privacyStatus,\n  selfDeclaredMadeForKids: meta.madeForKids === true,\n  license: meta.license || 'youtube',\n  embeddable: meta.embeddable !== false,\n  publicStatsViewable: meta.publicStatsViewable !== false,\n};\nif (meta.publishAt) status.publishAt = meta.publishAt;\nif (meta.containsSyntheticMedia === true) status.containsSyntheticMedia = true;\n\nreturn [\n  {\n    json: {\n      channelName: cfg.channelName,\n      pendingFolderId: cfg.pendingFolderId,\n      doneFolderId: cfg.doneFolderId,\n      failedFolderId: cfg.failedFolderId,\n      baseName,\n      // escape dau nhay don cho query cua Drive API\n      baseNameQ: baseName.replace(/'/g, \"\\\\'\"),\n      jsonFileId: trigger.id,\n      jsonFileName: trigger.name,\n      title,\n      description,\n      tags: tags.join(','),\n      categoryId: String(meta.categoryId || '22'),\n      status,\n    },\n  },\n];"
      },
