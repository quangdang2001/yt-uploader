      "id": "edc9be33-1622-4af4-a47a-439327d20f64",
      "name": "Tai JSON metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        -20
      ],
      "retryOnFail": true,
      "maxTries": 3,
