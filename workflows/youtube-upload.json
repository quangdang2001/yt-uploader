    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Moi file mot item -> node Google Drive se move lan luot tung file.\nconst f = $('Ghep thong tin file').first().json;\nconst up = $('Upload YouTube').first().json;\nconst videoId = up.id || up.uploadId || null;\n\nconst files = [\n  { fileId: f.mp4FileId, name: f.mp4Name },\n  { fileId: f.jsonFileId, name: f.jsonFileName },\n];\nif (f.thumbFileId) files.push({ fileId: f.thumbFileId, name: f.thumbName });\n\nreturn files.map((x) => ({\n  json: {\n    ...x,\n    destFolderId: f.doneFolderId,\n    channelName: f.channelName,\n    baseName: f.baseName,\n    videoId,\n    videoUrl: videoId ? `https://youtu.be/${videoId}` : null,\n  },\n}));"
      },
