    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Tu ket qua files.list, tach ra file video (bat buoc) va thumbnail (tuy chon).\nconst meta = $('Chuan hoa metadata').first().json;\nconst files = $input.first().json.files || [];\nconst base = meta.baseName.toLowerCase();\n\nconst nameOf = (f) => String(f.name || '');\nconst stem = (f) => nameOf(f).replace(/\\.[^.]+$/, '').toLowerCase();\n\nconst mp4 = files.find((f) => nameOf(f).toLowerCase() === `${base}.mp4`);\nconst thumb = files.find((f) => /\\.(jpe?g|png)$/i.test(nameOf(f)) && stem(f) === base);\n\nif (!mp4) {\n  throw new Error(\n    `Khong tim thay ${meta.baseName}.mp4 trong folder pending. ` +\n      `Pipeline phai upload video TRUOC file .json.`\n  );\n}\n\nreturn [\n  {\n    json: {\n      ...meta,\n      mp4FileId: mp4.id,\n      mp4Name: nameOf(mp4),\n      mp4Size: Number(mp4.size || 0),\n      hasThumb: Boolean(thumb),\n      thumbFileId: thumb ? thumb.id : null,\n      thumbName: thumb ? nameOf(thumb) : null,\n    },\n  },\n];"
      },
