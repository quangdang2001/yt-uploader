    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Chay khi bat ky node nao trong luong chinh bao loi.\n// Cac node phia tren co the chua tung chay, nen moi lan doc deu bo trong try.\nconst trigger = $('Trigger Drive pending').first().json;\n\nconst safe = (fn) => {\n  try {\n    return fn();\n  } catch (e) {\n    return null;\n  }\n};\n\nconst cfg = safe(() => $('Cau hinh kenh').first().json) || {};\nconst meta = safe(() => $('Chuan hoa metadata').first().json);\nconst fileInfo = safe(() => $('Ghep thong tin file').first().json);\nconst up = safe(() => $('Upload YouTube').first().json);\nconst videoId = up ? up.id || up.uploadId || null : null;\n\n// Neu video DA len YouTube thi khong day sang failed/: de o failed/ se gay hieu\n// lam la video chua len, upload lai se trung video va ton them 1600 quota.\nconst destFolderId = videoId\n  ? (meta && meta.doneFolderId) || cfg.doneFolderId\n  : (meta && meta.failedFolderId) || cfg.failedFolderId;\n\nconst files = [{ fileId: trigger.id, name: trigger.name }];\nif (fileInfo && fileInfo.mp4FileId) {\n  files.push({ fileId: fileInfo.mp4FileId, name: fileInfo.mp4Name });\n}\nif (fileInfo && fileInfo.thumbFileId) {\n  files.push({ fileId: fileInfo.thumbFileId, name: fileInfo.thumbName });\n}\n\nconst raw = $input.first().json || {};\nlet detail = raw.error || raw.message || 'Loi khong ro';\nif (typeof detail === 'object') {\n  detail = detail.message || JSON.stringify(detail).slice(0, 800);\n}\n\nconst prefix = videoId\n  ? `Video DA len YouTube (id ${videoId}) nhung buoc sau bi loi`\n  : 'Upload that bai';\n\nconst errorMessage =\n  `[${cfg.channelName || '?'}] ${(meta && meta.baseName) || trigger.name}\\n` +\n  `${prefix}: ${detail}\\n` +\n  `File da chuyen sang: ${videoId ? 'done/' : 'failed/'}\\n` +\n  `Execution: ${$execution.id}`;\n\nreturn files.map((x) => ({\n  json: {\n    ...x,\n    destFolderId,\n    videoId,\n    channelName: cfg.channelName || null,\n    baseName: (meta && meta.baseName) || null,\n    executionId: $execution.id,\n    errorMessage,\n  },\n}));"
      },
