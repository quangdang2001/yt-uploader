# Đổi tên file này thành .env rồi điền giá trị

# Subdomain trỏ qua Cloudflare Tunnel, ví dụ: n8n.tenmien.com
N8N_DOMAIN=n8n.tenmien.com

# Tạo bằng: openssl rand -hex 32
# GIỮ KỸ: mất key này là mất toàn bộ credential đã lưu trong n8n
N8N_ENCRYPTION_KEY=

# Lấy trong Cloudflare Zero Trust > Networks > Tunnels > tạo tunnel > Docker
CLOUDFLARE_TUNNEL_TOKEN=

# Giới hạn heap của Node.js (MB). 1536 cho VPS 2GB, 2560 cho VPS 4GB.
N8N_MAX_HEAP_MB=1536
